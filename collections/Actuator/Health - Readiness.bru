meta {
  name: Health - Readiness
  type: http
  seq: 3
}

get {
  url: {{base_url}}/actuator/health/readiness
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Probe de readiness - indica se a aplicação está pronta para receber tráfego.
  
  Usado por Kubernetes/Docker para verificar se o container deve receber requisições.
  
  Retorna:
  - status: UP (aplicação está pronta)
}
