meta {
  name: Health - Liveness
  type: http
  seq: 2
}

get {
  url: {{base_url}}/actuator/health/liveness
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Probe de liveness - indica se a aplicação está viva.
  
  Usado por Kubernetes/Docker para verificar se o container deve ser reiniciado.
  
  Retorna:
  - status: UP (aplicação está rodando)
}
